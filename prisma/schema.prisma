generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  RECEPTION
  TECHNICIAN
}

enum JobStatus {
  PRZYJETE
  DIAGNOSTYKA
  W_NAPRAWIE
  OCZEKUJE_NA_CZESCI
  GOTOWE_DO_ODBIORU
  WYDANE
  ANULOWANE
}

enum OfferType {
  MULTI
  PRODUCT_CARD
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum CalendarSyncStatus {
  DISCONNECTED
  LOCAL_ONLY
  SYNCED
  ERROR
}

enum SmsStatus {
  SENT
  FAILED
  SKIPPED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  sessions     Session[]
  jobs         Job[]    @relation("TechnicianJobs")
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model Job {
  id                String     @id @default(cuid())
  code              String     @unique
  status            JobStatus  @default(PRZYJETE)
  clientName        String
  clientPhone       String
  clientEmail       String?
  deviceType        String
  deviceBrand       String?
  deviceModel       String
  serialNumber      String?
  accessories       String?
  issueDescription  String
  devicePinEnc      String?
  devicePasswordEnc String?
  notes             String?
  technicianId      String?
  technician        User?      @relation("TechnicianJobs", fields: [technicianId], references: [id])
  promisedPickupAt  DateTime?
  chargeGrosze      Int        @default(0)
  googleEventId     String?
  calendarSync      CalendarSyncStatus @default(LOCAL_ONLY)
  calendarError     String?
  publicStatusToken String     @unique
  smsConsentAt      DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  releasedAt        DateTime?
  smsMessages       SmsMessage[]

  @@index([status])
  @@index([promisedPickupAt])
  @@index([createdAt])
}

model SmsMessage {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  to         String
  body       String    @db.Text
  purpose    String    @default("intake_confirm")
  status     SmsStatus
  provider   String
  providerId String?
  error      String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([jobId])
  @@index([createdAt])
}

model Offer {
  id          String      @id @default(cuid())
  number      String      @unique
  type        OfferType
  title       String
  clientName  String
  clientPhone String?
  clientEmail String?
  validUntil  DateTime?
  status      OfferStatus @default(DRAFT)
  vatRate     Int         @default(23)
  notes       String?
  publicToken String      @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lines       OfferLine[]
  product     ProductCard?
}

model OfferLine {
  id             String @id @default(cuid())
  offerId        String
  offer          Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  position       Int
  sku            String?
  name           String
  description    String?
  qty            Int    @default(1)
  unitPriceNetGr Int
}

model ProductCard {
  id          String  @id @default(cuid())
  offerId     String  @unique
  offer       Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  sku         String?
  ean         String?
  brand       String?
  model       String?
  condition   String  @default("Nowy")
  inStock     Boolean @default(true)
  title       String
  description String  @db.Text
  priceGrossGr Int
  keyParams   Json
  specs       Json
  images      Json
  rawPaste    String? @db.Text
}

model InventoryItem {
  id     String @id @default(cuid())
  sku    String @unique
  name   String
  qty    Int
  minQty Int    @default(1)
  unit   String @default("szt.")
}

model CalendarConnection {
  id               String    @id @default("default")
  encryptedTokens  String?   @db.Text
  calendarId       String    @default("primary")
  connectedEmail   String?
  lastSyncAt       DateTime?
  status           CalendarSyncStatus @default(DISCONNECTED)
  errorMessage     String?
}

model CalendarEvent {
  id            String             @id @default(cuid())
  jobId         String?
  offerId       String?
  title         String
  description   String?
  startAt       DateTime
  endAt         DateTime
  type          String
  googleEventId String?
  syncStatus    CalendarSyncStatus @default(LOCAL_ONLY)
  location      String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([startAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, ip, createdAt])
}

model Setting {
  key   String @id
  value String
}

model UploadedFile {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  path      String
  createdAt DateTime @default(now())
}
