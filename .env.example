# KS panel — skopiuj do .env i uzupełnij.
# Nie commituj prawdziwych sekretów.

# Postgres
DATABASE_URL="postgresql://ks:ks@localhost:5432/ks_panel?schema=public"

# Sesje (min. 32 znaki). Wygeneruj: openssl rand -hex 32
SESSION_SECRET="zmien-mnie-wygeneruj-openssl-rand-hex-32"

# Szyfrowanie PIN/hasła urządzenia i tokenów Google (64 znaki hex = 32 bajty).
# Wygeneruj: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# true na HTTPS / produkcji (Secure na ciasteczkach + HSTS)
AUTH_SECURE_COOKIES="false"

# Publiczny URL aplikacji (OAuth, linki w PDF/HTML)
APP_URL="http://localhost:3000"

# Seed danych DEMO (konta testowe — opisane w README). Nie używaj na produkcji z prawdziwymi klientami.
SEED_DEMO_DATA="false"

# --- Google Calendar (opcjonalnie) ---
# Bez tych wartości terminy zapisują się lokalnie, a panel pokazuje status „niepołączony”.
# Nigdy nie udajemy udanej synchronizacji.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/callback"
# ID kalendarza, domyślnie 'primary'
GOOGLE_CALENDAR_ID="primary"

# Testy: mock Google API (bez sieci)
GOOGLE_MOCK="false"

# --- SMS (potwierdzenie przyjęcia) ---
# none = nie wysyłaj (domyślnie). mock = testy. smsapi = SMSAPI.pl (Polska). twilio = Twilio.
# Aplikacja nigdy nie udaje udanego SMS przy SMS_PROVIDER=none.
SMS_PROVIDER="none"
# Token OAuth SMSAPI.pl (https://ssl.smsapi.pl/ → API → tokeny)
SMS_API_TOKEN=""
# Nadawca zarejestrowany w SMSAPI (np. KS) albo numer 2-way
SMS_SENDER=""
# Opcjonalnie inny endpoint (domyślnie https://api.smsapi.pl/sms.do)
SMSAPI_URL=""
# Twilio (gdy SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Testy: SMS_PROVIDER=mock albo SMS_MOCK=true. SMS_MOCK_FAIL=true udaje awarię bramki.
SMS_MOCK="false"

# Dane firmy — można też zmienić w Ustawieniach po zalogowaniu
COMPANY_NIP=""
COMPANY_REGON=""
